# Used by docker-compose.yml. Copy to .env and change the passwords.
POSTGRES_USER=sep
POSTGRES_PASSWORD=sep

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Password of the development users imported into Keycloak (driver1, superadmin, customer1, customer2).
KEYCLOAK_DEV_USER_PASSWORD=devpassword123
# Secret of the psp-backend Keycloak client. Generate one with: openssl rand -hex 32
PSP_KEYCLOAK_CLIENT_SECRET=change-me
