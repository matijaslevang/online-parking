PORT=8082
DATABASE_URL=postgres://sep:sep@localhost:5432/psp?sslmode=disable
# Issuer written in tokens. Must match Keycloak's public URL exactly.
KEYCLOAK_ISSUER_URL=https://auth.localhost/realms/psp
# Where token signing keys are downloaded from. Outside Docker this is the public URL (needs a trusted mkcert certificate).
KEYCLOAK_JWKS_URL=https://auth.localhost/realms/psp/protocol/openid-connect/certs
# Tokens must be issued for this API (added by the audience mapper in the Keycloak realm).
KEYCLOAK_AUDIENCE=psp-api
# Admin API access for creating merchant users. The secret must match PSP_KEYCLOAK_CLIENT_SECRET in the root .env.
KEYCLOAK_URL=https://auth.localhost
KEYCLOAK_REALM=psp
KEYCLOAK_CLIENT_ID=psp-backend
KEYCLOAK_CLIENT_SECRET=change-me
