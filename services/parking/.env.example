PORT=8081
DATABASE_URL=postgres://sep:sep@localhost:5432/parking?sslmode=disable
# Issuer written in tokens. Must match Keycloak's public URL exactly.
KEYCLOAK_ISSUER_URL=https://auth.localhost/realms/parking
# Where token signing keys are downloaded from. Outside Docker this is the public URL (needs a trusted mkcert certificate).
KEYCLOAK_JWKS_URL=https://auth.localhost/realms/parking/protocol/openid-connect/certs
